# ── FLAVOR COFFEE ROASTERS — ENVIRONMENT CONFIGURATION EXAMPLE ───────────────
# Copy this file to server/.env on your production VPS.
# DO NOT commit real API keys or private secrets to version control.

# Server / Private Configuration (Server-side ONLY)
NODE_ENV=production
PORT=3001
CLIENT_ORIGIN=https://flavorcoffee.com
TO_EMAIL=flavorcoffee.team@gmail.com

# Email Delivery Credentials (Resend API)
RESEND_API_KEY=

# Cloudflare Turnstile Bot Protection Secret Key
TURNSTILE_SECRET_KEY=

# Frontend / Public Configuration (Optional)
# VITE_API_URL=/api/contact
